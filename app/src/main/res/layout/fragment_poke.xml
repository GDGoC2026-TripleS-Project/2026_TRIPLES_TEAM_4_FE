<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="찌르기"
        style="@style/head2_b_22"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="10dp"
        android:layout_alignParentTop="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPokeList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvScreenTitle"
        android:layout_marginTop="10dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp">

        <android.widget.Button
            android:background="@drawable/shape_button_join"
            android:id="@+id/btnSendPoke"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="찌르기"
            style="@style/body2_b_18"
            android:enabled="false"
            android:backgroundTint="@color/gray02"
            android:textColor="@color/gray05"/>

    </LinearLayout>

</RelativeLayout>
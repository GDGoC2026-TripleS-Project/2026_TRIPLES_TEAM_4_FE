<?xml version="1.0" encoding="utf-8"?>
<!-- 참고: 일정 카테고리 드롭다운과 동일 스타일 - 끝 살짝 둥근 카드, 그림자, 옵션 전체 노출 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dropdown_list_shadow"
    android:elevation="8dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/dropdownItem0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/none"
        android:textSize="14sp"
        android:textColor="@color/gray09"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/dropdownItem1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="5분 전"
        android:textSize="14sp"
        android:textColor="@color/gray09"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/dropdownItem2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="15분 전"
        android:textSize="14sp"
        android:textColor="@color/gray09"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/dropdownItem3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="30분 전"
        android:textSize="14sp"
        android:textColor="@color/gray09"
        android:background="?attr/selectableItemBackground" />

    <TextView
        android:id="@+id/dropdownItem4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="1시간 전"
        android:textSize="14sp"
        android:textColor="@color/gray09"
        android:background="?attr/selectableItemBackground" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageButton
        android:id="@+id/teamShareBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_backward"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivShareLogo"
        android:layout_width="74dp"
        android:layout_height="35dp"
        android:layout_marginTop="180dp"
        android:src="@drawable/ic_uni_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/shareLayoutCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="20dp"
        android:paddingBottom="20dp"
        android:background="@drawable/shape_complete_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivShareLogo">

        <TextView
            android:id="@+id/tvShareMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="33dp"
            android:text="팀 초대 코드를 공유해보세요!"
            android:textColor="@color/green08"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/pretendard_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/shareLayoutCode"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/shape_code_box"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvShareMsg">

            <TextView
                android:id="@+id/tvShareInviteCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="#151515"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivShareCopyIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_copy" />
        </LinearLayout>

        <!-- 남은 시간 카운트다운 -->
        <TextView
            android:id="@+id/tvShareCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/gray06"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/shareLayoutCode" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShareCopyCode"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/shape_button_create"
            android:elevation="0dp"
            android:fontFamily="@font/pretendard_semibold"
            android:stateListAnimator="@null"
            android:text="초대코드 복사"
            android:textAllCaps="false"
            android:textColor="@color/green10"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvShareCountdown" />

        <!-- 재발급 버튼: 팀장만 노출 (기본 gone) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnShareReissue"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="18dp"
            android:background="@drawable/shape_button_create"
            android:elevation="0dp"
            android:fontFamily="@font/pretendard_semibold"
            android:stateListAnimator="@null"
            android:text="새 코드 재발급"
            android:textAllCaps="false"
            android:textColor="@color/green10"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnShareCopyCode" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

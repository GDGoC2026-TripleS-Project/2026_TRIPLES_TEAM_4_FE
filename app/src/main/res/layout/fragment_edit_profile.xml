<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.profile.ProfileCreateFragment">

    <ImageButton
        android:id="@+id/editProfileBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_backward"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="116dp"
        android:layout_height="36dp"
        android:layout_marginTop="70dp"
        android:src="@drawable/ic_unimate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/editProfileBack" />

    <TextView
        android:id="@+id/tv_profile_edit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        style="@style/body2_m_18"
        android:text="프로필 수정"
        android:textColor="@color/gray08"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_logo" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_profile_edit"
        android:layout_width="103dp"
        android:layout_height="103dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="51.5dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_profile_edit_title">

        <ImageView
            android:id="@+id/iv_profile_edit_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/profile_bg"
            android:scaleType="centerInside"
            android:src="@drawable/ic_profile_user" />
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/iv_edit_profile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_add_circle"
        android:elevation="2dp"

        app:layout_constraintBottom_toBottomOf="@id/cv_profile_edit"
        app:layout_constraintEnd_toEndOf="@id/cv_profile_edit"

        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp" />


    <EditText
        android:id="@+id/et_name_edit"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/shape_edittext_default"
        android:hint="이름"
        style="@style/body2_m_14"
        android:textColor="@color/gray06"
        android:inputType="text"
        android:paddingStart="16dp"
        android:privateImeOptions="defaultInputMode=korean"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_profile_edit" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="38dp"
        app:layout_constraintEnd_toEndOf="@id/et_name_edit"
        app:layout_constraintStart_toStartOf="@id/et_name_edit"
        app:layout_constraintTop_toBottomOf="@id/et_name_edit">

        <Button
            android:id="@+id/profile_edit_confirm"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:layout_marginEnd="15dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="저장"
            android:textColor="@color/gray08"
            style="@style/body2_m_16"
            app:backgroundTint="@color/main_green"
            app:cornerRadius="12dp"
            />


        <Button
            android:id="@+id/profile_edit_cancel"
            android:layout_width="150dp"
            android:layout_height="50dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="취소"
            android:textColor="@color/gray08"
            style="@style/body2_m_16"
            app:backgroundTint="@color/gray02"
            app:cornerRadius="12dp"
            />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:minHeight="48dp">

    <TextView
        android:id="@+id/chipTeamName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:layout_marginTop="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="28dp"
        android:paddingBottom="4dp"
        android:minHeight="26dp"
        android:background="@drawable/bg_team_chip"
        android:textColor="@color/black"
        style="@style/body2_m_14"
        tools:text="캡스톤" />

    <FrameLayout
        android:id="@+id/chipRemoveWrap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">
        <ImageButton
            android:id="@+id/chipRemove"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="6dp"
            android:layout_gravity="end"
            android:background="@null"
            android:contentDescription="제거"
            android:src="@drawable/ic_close_x"
            app:tint="@color/black"
            android:scaleType="centerInside" />
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_marginHorizontal="40dp"
    android:paddingHorizontal="30dp"
    android:layout_height="190dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_dialog_team_delete_confirm"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/deleteConfirmMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="45dp"
        android:text="팀 스페이스를 삭제하시겠습니까?"
        android:textColor="@color/gray08"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="38dp">

        <Button
            android:id="@+id/dialogTeamEndConfirm"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginEnd="15dp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/delete_red"
            android:text="삭제"
            android:textColor="@color/white"
            style="@style/body2_r_16" />

        <Button
            android:id="@+id/dialogTeamEndCancel"
            android:layout_width="120dp"
            android:layout_height="40dp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/gray02"
            android:text="취소"
            android:textColor="@color/gray08"
            style="@style/body2_r_16" />

    </LinearLayout>
</LinearLayout>
